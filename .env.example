# ==========================================
# FinSight AI - Environment Configuration Template
# ==========================================

# Database Configuration (PostgreSQL / Prisma on Render)
DATABASE_URL="postgresql://username:password@localhost:5432/finsight_db?schema=public"

# AI / Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# Frontend API Base URL (Used by Vercel deployment)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Backend CORS Allowed Origin (Used by Render deployment)
CLIENT_ORIGIN="http://localhost:5173"

# Server Port (Render sets this dynamically)
PORT=5000

# Firebase Client Configuration (Frontend)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

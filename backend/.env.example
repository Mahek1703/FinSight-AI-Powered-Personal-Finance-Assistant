# ==========================================
# FinSight AI Backend Environment Variables (Render Deployment)
# ==========================================

# Port (Render sets this dynamically)
PORT=5000

# Backend CORS Allowed Origins (Comma-separated list of origins)
CLIENT_ORIGIN="http://localhost:5173,https://your-app.vercel.app"

# Firebase Cloud Firestore & Admin Auth
FIREBASE_PROJECT_ID="your-firebase-project-id"
# Firebase service account private key credentials as a single minified JSON string
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}'

# Google Gemini AI API Configuration
GEMINI_API_KEY="your-gemini-api-key"
# Supported Gemini Model (e.g. gemini-3.5-flash)
GEMINI_MODEL="gemini-3.5-flash"

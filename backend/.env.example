# Backend Environment Variables (Render Deployment)

# Database Configuration (PostgreSQL / Prisma on Render)
DATABASE_URL="postgresql://username:password@localhost:5432/finsight_db?schema=public"

# AI / Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN="http://localhost:5173"

# Port (Render sets this automatically)
PORT=5000
